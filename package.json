{
  "name": "vue-experiment",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^26.13.1"
  },
  "scripts": {
    "serve": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint --fix .",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:typecheck": "node tests/typecheck.test.js"
  },
  "dependencies": {
    "vue": "^3.5.45",
    "vue-i18n": "^11.4.20",
    "vue-router": "^5.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/test-utils": "^2.6.0",
    "eslint": "^10.15.0",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  },
  "overrides": {
    "js-beautify": {
      "glob": "^14.0.6",
      "editorconfig": "^4.0.1"
    }
  }
}
